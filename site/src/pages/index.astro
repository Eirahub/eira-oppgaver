---
import fs from 'node:fs';
import path from 'node:path';
import YAML from 'yaml';
import Base from '../layouts/Base.astro';
import CourseCard from '../components/CourseCard.astro';
import { getCourses, renderMarkdown } from '../lib/content.js';
import { groupCourses } from '../lib/kursgrupper.js';
import profile, { PROFILE_DIR } from '../lib/profile.js';

const courses = getCourses();
const internal = courses.filter((c) => !c.isExternal && c.lessons.length);
const external = courses.filter((c) => c.isExternal);
// Shared groups in src/data, unless the profile has its own list.
const groupFile = [path.join(PROFILE_DIR, 'kursgrupper.yml'), 'src/data/kursgrupper.yml'].find((f) => fs.existsSync(f));
// External courses join their technology group here (marked ↗); the alphabetical view keeps them in their own section.
const groups = groupCourses([...internal, ...external], YAML.parse(fs.readFileSync(groupFile, 'utf8')));
const slug = (s) => `gruppe-${s.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
<Base>
  <section class="hero">
    <p class="eyebrow">{profile.hero.eyebrow}</p>
    <h1>{profile.hero.title}</h1>
    <div class="lead" set:html={renderMarkdown(profile.hero.lead)} />
  </section>

  <section class="site-search" id="sok" aria-labelledby="sok-tittel" hidden>
    <h2 class="section-title" id="sok-tittel">Søk i oppgavene</h2>
    <div id="sok-felt"></div>
  </section>
  <script is:inline>
    // Pagefind's default UI. The index is built after `astro build` (npm run build), so in `npm run dev`
    // and without JavaScript the search stays hidden.
    (() => {
      const box = document.getElementById('sok');
      const css = Object.assign(document.createElement('link'), { rel: 'stylesheet', href: '/pagefind/pagefind-ui.css' });
      const js = Object.assign(document.createElement('script'), { src: '/pagefind/pagefind-ui.js' });
      const clean = (url) => url.replace(/\.html(?=$|#)/, ''); // same URLs as the links on the site
      js.onload = () => {
        new PagefindUI({
          element: '#sok-felt',
          showImages: false,
          showSubResults: true,
          resetStyles: false,
          translations: { placeholder: 'Søk i oppgavene', zero_results: 'Fant ingen oppgaver med [SEARCH_TERM]' },
          processResult: (r) => {
            r.url = clean(r.url);
            for (const s of r.sub_results || []) s.url = clean(s.url);
            return r;
          },
        });
        box.querySelector('input')?.setAttribute('aria-labelledby', 'sok-tittel');
        box.hidden = false;
      };
      document.head.append(css, js);
    })();
  </script>

  {profile.teacherInfo && (
    <section class="teacher-info teacher-only" set:html={renderMarkdown(profile.teacherInfo, '/')} />
  )}

  <div class="courses-head">
    <h2 class="section-title">Kurs</h2>
    <fieldset class="view-switch" id="course-view" hidden>
      <legend>Vis kursene</legend>
      <label><input type="radio" name="kursvisning" value="teknologi" checked /> Etter teknologi</label>
      <label><input type="radio" name="kursvisning" value="alfabetisk" /> Alfabetisk</label>
    </fieldset>
  </div>

  <div id="kurs-teknologi">
    {groups.map((g) => (
      <section class="course-group" aria-labelledby={slug(g.title)}>
        <h3 id={slug(g.title)}>{g.title}</h3>
        <ul class="course-grid">{g.courses.map((c) => <CourseCard c={c} />)}</ul>
      </section>
    ))}
  </div>

  <div id="kurs-alfabetisk" hidden>
    <ul class="course-grid">{internal.map((c) => <CourseCard c={c} />)}</ul>
    <h2 class="section-title">Kurs på andre nettsider</h2>
    <ul class="course-grid">{external.map((c) => <CourseCard c={c} />)}</ul>
  </div>

  <script is:inline>
    // Right after the lists, so a saved "Alfabetisk" shows before first paint. Without JS: grouped by technology.
    (() => {
      const KEY = 'kursvisning';
      const views = { teknologi: document.getElementById('kurs-teknologi'), alfabetisk: document.getElementById('kurs-alfabetisk') };
      const show = (view) => { for (const [name, el] of Object.entries(views)) el.hidden = name !== view; };
      let saved = null;
      try { saved = localStorage.getItem(KEY); } catch { /* blocked storage: default view */ }
      const view = views[saved] ? saved : 'teknologi';
      const switcher = document.getElementById('course-view');
      switcher.querySelector(`input[value="${view}"]`).checked = true;
      show(view);
      switcher.hidden = false;
      switcher.addEventListener('change', (e) => {
        show(e.target.value);
        try { localStorage.setItem(KEY, e.target.value); } catch { /* not saved, still switches */ }
      });
    })();
  </script>
</Base>
