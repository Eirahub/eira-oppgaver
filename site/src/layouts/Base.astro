---
import 'highlight.js/styles/github.css';
import '../styles/global.css';
import profile from '../lib/profile.js';
import { renderMarkdown } from '../lib/content.js';
const { title, description = profile.description } = Astro.props;
const fullTitle = title ? `${title} | ${profile.name}` : profile.name;
const tokens = `:root{${Object.entries(profile.tokens).map(([k, v]) => `${k}:${v}`).join(';')}}`;
const { logo, lockup } = profile;
---
<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {profile.favicon && <link rel="icon" href={profile.favicon} />}
    {(profile.preload || []).map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta name="theme-color" content={profile.tokens['--brand-primary']} />
    <style is:inline set:html={tokens}></style>
    <script is:inline>
      // Teacher mode before first paint. Same key and values as codeclub-viewer, so the choice carries over.
      try { if (localStorage.getItem('isStudentMode') === 'false') document.documentElement.dataset.mode = 'teacher'; } catch { /* blocked storage: student mode */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#innhold">Hopp til innhold</a>
    <header class="site-header">
      <div class="wrap header-inner">
        {logo ? (
          <a class="lockup" href="/"><img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} /></a>
        ) : (
          <a class="lockup" href="/" aria-label={`${lockup.label}, til forsiden`}>
            <span class="lockup-mark">{lockup.mark}</span>
            <span class="lockup-kicker">{lockup.kicker}</span>
          </a>
        )}
        <nav aria-label="Hovedmeny">
          {profile.nav.map((l) => <a href={l.href}>{l.label}</a>)}
          <button type="button" class="mode-toggle" id="mode-toggle" aria-pressed="false" hidden>Lærermodus</button>
        </nav>
      </div>
    </header>
    <main id="innhold" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <Fragment set:html={renderMarkdown(profile.footer || '')} />
        {profile.partners.length > 0 && (
          <ul class="partners" aria-label="Samarbeidspartnere">
            {profile.partners.map((p) => <li><a href={p.href}><img src={p.logo} alt={p.name} /></a></li>)}
          </ul>
        )}
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById('mode-toggle');
        const sync = () => button.setAttribute('aria-pressed', String(root.dataset.mode === 'teacher'));
        button.hidden = false; // without JavaScript the site stays in student mode
        sync();
        button.addEventListener('click', () => {
          const teacher = root.dataset.mode !== 'teacher';
          if (teacher) root.dataset.mode = 'teacher'; else delete root.dataset.mode;
          try { localStorage.setItem('isStudentMode', JSON.stringify(!teacher)); } catch { /* not saved, still switches */ }
          sync();
        });
      })();
    </script>
  </body>
</html>
